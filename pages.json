{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "菜单",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/cart/cart",
      "style": {
        "navigationBarTitleText": "购物车"
      }
    },
    {
      "path": "pages/favorite/favorite",
      "style": {
        "navigationBarTitleText": "我的收藏"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pkg-discover",
      "pages": [
        {
          "path": "detail/detail",
          "style": {
            "navigationBarTitleText": "菜品详情"
          }
        },
        {
          "path": "search/search",
          "style": {
            "navigationBarTitleText": "搜索"
          }
        }
      ]
    },
    {
      "root": "pkg-tools",
      "pages": [
        {
          "path": "shopping/shopping",
          "style": {
            "navigationBarTitleText": "采购清单"
          }
        },
        {
          "path": "history/history",
          "style": {
            "navigationBarTitleText": "浏览历史"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pkg-discover"]
    },
    "pages/cart/cart": {
      "network": "all",
      "packages": ["pkg-tools"]
    },
    "pages/favorite/favorite": {
      "network": "all",
      "packages": ["pkg-discover"]
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#FF6B6B",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "菜单",
        "iconPath": "static/tabbar/menu.png",
        "selectedIconPath": "static/tabbar/menu-active.png"
      },
      {
        "pagePath": "pages/cart/cart",
        "text": "购物车",
        "iconPath": "static/tabbar/cart.png",
        "selectedIconPath": "static/tabbar/cart-active.png"
      },
      {
        "pagePath": "pages/favorite/favorite",
        "text": "收藏",
        "iconPath": "static/tabbar/favorite.png",
        "selectedIconPath": "static/tabbar/favorite-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "家庭菜单",
    "navigationBarBackgroundColor": "#F7F6F3",
    "backgroundColor": "#F7F6F3"
  },
  "uniIdRouter": {}
}
